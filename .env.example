# Supabase — انسخ الملف ده إلى .env.local واملأ القيم من لوحة تحكم Supabase
# (Project Settings → API Keys). أسامي المتغيرات هنا بالطريقة الحديثة
# (publishable/secret) بدل القديمة (anon/service_role).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# مفتاح السر — للخادم فقط، لا يُستخدم في المتصفح إطلاقاً
SUPABASE_SECRET_KEY=
